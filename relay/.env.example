# Copy to relay/.env (Git-ignored) and fill in. Never commit relay/.env.
# Values set in the real environment override this file.

# Required. Long random string; the Foundry module sends it as X-Pilot-Secret.
PILOT_SHARED_SECRET=replace-with-a-long-random-string

# Anthropic (Claude). The key lives here only: not in Foundry, not in Git.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=low          # low|medium|high|xhigh|max; unset = model default
# ANTHROPIC_FALLBACKS=default   # default|off (server-side refusal fallback)

# Local model through any OpenAI-compatible endpoint (Ollama by default).
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=gpt-oss:20b
# OPENAI_API_KEY=

# Network
HOST=127.0.0.1
PORT=5090
PILOT_ALLOWED_ORIGINS=https://foundry.lab.spiralfrenzy.com

# Limits and logging
# PILOT_UPSTREAM_TIMEOUT_MS=120000
# PILOT_MAX_BODY_BYTES=1048576
# PILOT_DEFAULT_MAX_TOKENS=16000
# PILOT_MAX_TOKENS_LIMIT=64000
# PILOT_LOG_PROMPTS=1
